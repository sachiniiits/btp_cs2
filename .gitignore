# ── CS2 Demo Files ────────────────────────────────────────────────
# Raw demo files are 100–200 MB each and cannot be redistributed
*.dem
data/raw_dems/

# ── Pipeline Output Data ──────────────────────────────────────────
# Parquet files can be large and are reproducible by running the pipeline
*.parquet
outputs/*.parquet

# Keep sample visualisation PNGs (small, good for README showcase)
# outputs/sample/*.png  <-- NOT ignored, commit these

